# Copy to `.env` (do not commit `.env`).
# PORT: Vite dev/preview bind (sybilionStandaloneViteDev). 3000 matches common Auth0 localhost URLs.
PORT=3000

# Frontend auth profile: mock (always authenticated demo user) | auth0 (real Auth0 sign-in)
VITE_AUTH_MODE=auth0

VITE_SYBILION_API_BASE_URL=https://api-dev.sybilion.com
VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id

# Auth0 Audience (optional) - your API identifier for token validation
# Only needed if you're validating tokens server-side
# Example: https://your-api-identifier
VITE_AUTH0_AUDIENCE=

# Auth0 Connection (optional) - database connection name for sign-in hint
VITE_AUTH0_CONNECTION=

# Agent chat service (optional) — when set, chat POSTs to {url}/chat with Sybilion JWT.
# Omit for local echo stub (mock demos). auth0 mode requires sign-in + token exchange first.
# Example: https://agent-staging.sybilion.com
VITE_AGENT_SERVICE_URL=
