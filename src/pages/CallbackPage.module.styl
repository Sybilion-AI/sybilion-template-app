.root
  display: flex
  align-items: center
  justify-content: center
  min-height: 100vh
  width: 100%
  background: var(--background)
  padding: 2rem

.container
  display: flex
  flex-direction: column
  align-items: center
  gap: 1rem
  text-align: center
  max-width: 400px

.spinner
  width: 2rem
  height: 2rem
  border: 2px solid var(--muted-foreground)
  border-top-color: var(--foreground)
  border-radius: 50%
  animation: spin 0.8s linear infinite

@keyframes spin
  to
    transform: rotate(360deg)

.message
  color: var(--foreground)
  font-size: 0.875rem
  margin: 0
  line-height: 1.5
